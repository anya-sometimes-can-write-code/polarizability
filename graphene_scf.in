&control
    calculation = 'scf'
    prefix = 'graphene'
    pseudo_dir = './pseudo/'
    outdir = './tmp/'
/
&system
    ibrav = 4, celldm(1) = 4.65, celldm(3) = 6.0, ! Large c-axis (vacuum > 15 Å)
    nat = 2, ntyp = 1,
    ecutwfc = 60.0,
    occupations = 'smearing', smearing = 'mv', degauss = 0.01
/
&electrons
    conv_thr = 1.0d-12
/
ATOMIC_SPECIES
 C  12.011  C.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
C  0.000000000   0.000000000   0.250000000
C  0.333333333   0.666666667   0.250000000
K_POINTS automatic
 60 60 1 0 0 0  ! Very dense 2D grid to resolve Dirac cones
